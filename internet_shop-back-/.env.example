PORT=7777
# Without NODE_ENV=production TypeORM syncs the schema with the entities on every start
# (synchronize), which is handy locally. With NODE_ENV=production synchronize is off and
# `node dist/main` applies the migrations from src/migrations on start instead.
# A database created earlier by synchronize already has the tables: before the first
# production start, mark the initial migration as applied (or start from an empty database).
# NODE_ENV=production
# Public URL of this API, with trailing slash. Used to build uploaded file URLs.
BASE_URL=http://localhost:7777/
# Folder for uploaded product photos. Must be outside dist (it is wiped on every build).
# Default: internet_shop-back-/uploads. On a server, point it to persistent storage.
# UPLOADS_DIR=/var/lib/edelweiss/uploads

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Matches docker-compose.yml at the repo root (development only).
DB_PASSWORD=postgres
DB_NAME=Edelweiss

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# Access token lifetime (vercel/ms format: 15m, 1h, ...). Default 15m.
# JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime in days. Default 30.
# REFRESH_TOKEN_TTL_DAYS=30

# First admin created by `npm run seed` (development only).
SEED_ADMIN_PHONE=380990000000
SEED_ADMIN_PASSWORD=admin12345

# Mono acquiring token from Monobank merchant cabinet.
# MONO_ACQUIRING_TOKEN=

# Optional: pin the key mono signs webhooks with (base64, as returned by
# GET https://api.monobank.ua/api/merchant/pubkey). Without it the key is
# fetched with MONO_ACQUIRING_TOKEN and cached in memory.
# MONO_PUBLIC_KEY=

# Payment provider to use (currently only 'mono' is supported).
# PAYMENT_PROVIDER=mono

# Скільки хвилин діє рахунок mono (за замовчуванням 60). Після цього строку
# неоплачене замовлення карткою скасовується, а товар повертається на склад.
# PAYMENT_TIMEOUT_MINUTES=60

# Frontend URL for redirect after payment (with trailing slash).
# FRONTEND_URL=http://localhost:3000/
