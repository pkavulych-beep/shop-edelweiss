{
  "repo": "pkavulych-beep/shop-edelweiss",
  "intervalSeconds": 120,
  "issueLabel": "agent",
  "manualLabel": "manual",
  "autoPriorities": ["P0-critical", "P1-high", "P2-medium", "P3-low"],
  "priorityLabels": ["P0-critical", "P1-high", "P2-medium", "P3-low"],
  "difficultyLabels": ["hard", "medium", "easy"],
  "defaultDifficulty": "medium",
  "maxOpenPullRequests": 4,
  "maxReviewRounds": 3,
  "escalateTo": "opus",
  "maxFixRounds": 4,
  "maxIssueAttempts": 2,
  "needsInputMinutes": 20,
  "limitPauseMinutes": { "claude": 60, "codex": 360, "opencode": 60 },
  "releaseAfterHours": { "claude": 12, "codex": 12, "opencode": 1 },
  "modelDownHours": 6,
  "coders": {
    "opus": {
      "provider": "claude",
      "model": "opus",
      "effort": "high",
      "takes": ["hard"],
      "ports": { "back": 7777, "front": 3000, "db": "Edelweiss" }
    },
    "codex": {
      "provider": "codex",
      "model": "gpt-5.6-terra",
      "effort": "high",
      "takes": ["medium"],
      "ports": { "back": 7778, "front": 3001, "db": "Edelweiss_codex" }
    },
    "zen": {
      "provider": "opencode",
      "model": "opencode/big-pickle",
      "takes": ["easy", "medium"],
      "ports": { "back": 7780, "front": 3003, "db": "Edelweiss_zen" }
    },
    "deepseek": {
      "provider": "opencode",
      "model": "opencode/deepseek-v4.1-flash-free",
      "takes": ["easy", "medium"],
      "ports": { "back": 7781, "front": 3005, "db": "Edelweiss_deepseek" }
    },
    "glm": {
      "provider": "opencode",
      "model": "opencode/glm-5.3-flash-free",
      "takes": ["easy"],
      "ports": { "back": 7782, "front": 3006, "db": "Edelweiss_glm" }
    }
  },
  "reviewer": { "provider": "claude", "model": "opus", "effort": "high" },
  "reviewerFor": {
    "easy": { "provider": "claude", "model": "sonnet", "effort": "medium" }
  },
  "qa": {
    "enabled": true,
    "everyMerges": 10,
    "maxWaitHours": 24,
    "provider": "claude",
    "model": "sonnet",
    "effort": "medium",
    "maxIssues": 5,
    "paths": ["internet_shop-back-/", "internet_shop-front-/"],
    "ports": { "back": 7779, "front": 3002, "db": "Edelweiss_qa" }
  },
  "docker": { "enabled": true, "app": "Docker", "service": "db", "waitMinutes": 5 },
  "notify": { "enabled": true },
  "merge": {
    "enabled": true,
    "method": "squash",
    "maxChangedLines": 600,
    "okLabel": "merge-ok",
    "protectedPaths": [
      ".github/",
      ".claude/",
      ".codex/",
      "opencode.json",
      "AGENTS.md",
      "CLAUDE.md",
      "tools/conveyor/",
      "docker-compose.yml",
      "internet_shop-back-/.npmrc",
      "internet_shop-back-/src/payment/",
      "internet_shop-back-/src/auth/"
    ]
  }
}
