{
  "repo": "pkavulych-beep/shop-edelweiss",
  "intervalSeconds": 120,
  "issueLabel": "agent",
  "manualLabel": "manual",
  "autoPriorities": ["P0-critical", "P1-high", "P2-medium"],
  "priorityLabels": ["P0-critical", "P1-high", "P2-medium", "P3-low"],
  "maxOpenPullRequests": 2,
  "maxReviewRounds": 2,
  "maxFixRounds": 4,
  "maxIssueAttempts": 2,
  "needsInputMinutes": 20,
  "limitPauseMinutes": 60,
  "coder": { "provider": "claude", "model": "opus", "effort": "high" },
  "reviewer": { "provider": "claude", "model": "opus", "effort": "high" },
  "qa": {
    "enabled": true,
    "everyMerges": 10,
    "provider": "claude",
    "model": "sonnet",
    "effort": "medium",
    "maxIssues": 5,
    "paths": ["internet_shop-back-/", "internet_shop-front-/"]
  },
  "notify": { "enabled": true },
  "merge": {
    "enabled": true,
    "method": "squash",
    "maxChangedLines": 400,
    "protectedPaths": [
      ".github/",
      ".claude/",
      "AGENTS.md",
      "CLAUDE.md",
      "tools/conveyor/",
      "docker-compose.yml",
      "internet_shop-back-/.npmrc"
    ]
  }
}
